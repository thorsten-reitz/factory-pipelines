[Unit]
Description=Factory: Secrets aller Apps nach dem Start holen (vor Docker)
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/factory/bin/factory-host secrets-all
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
