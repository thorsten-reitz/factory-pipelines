#!/usr/bin/env bash
# factory-secrets <projekt> <umgebung> [infisical-projekt-id]
# Läuft als root (für deploy per sudoers freigegeben). Holt die Secrets einer App und legt sie als einzelne
# Dateien in $SECRETS_DIR/<projekt>-<umgebung>/ ab (tmpfs unter /run, nichts landet dauerhaft auf der Platte).
# Dateiname = Name des Secrets, Inhalt = Wert. Die Dateien werden an Ort und Stelle ersetzt, damit
# laufende Container (Bind-Mount des Ordners) den neuen Stand sehen.
set -euo pipefail
FACTORY_LIB="${FACTORY_LIB:-$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)}"
# shellcheck source=../lib/common.sh
. "$FACTORY_LIB/common.sh"
load_host_env

PROJECT="${1:-}"; ENVIRONMENT="${2:-}"; INFISICAL_ID="${3:-}"
valid_name "$PROJECT" || die "Ungültiger Projektname"
valid_env "$ENVIRONMENT" || die "Ungültige Umgebung"
[[ "$INFISICAL_ID" =~ ^[A-Za-z0-9-]*$ ]] || die "Ungültige Infisical-Projekt-ID"
NAME="$PROJECT-$ENVIRONMENT"
DEST="$SECRETS_DIR/$NAME"

mkdir -p "$SECRETS_DIR"
chmod 0755 "$SECRETS_DIR"
TMP=$(mktemp -d "$SECRETS_DIR/.factory-secrets.XXXXXX")
trap 'rm -rf "$TMP"' EXIT
chmod 0700 "$TMP"

case "$SECRETS_PROVIDER" in
  infisical)
    [ -n "$INFISICAL_ID" ] || die "Infisical-Projekt-ID fehlt (GitHub-Variable INFISICAL_PROJECT_ID)"
    [ -r "$CREDS_DIR/infisical-client-id" ] || die "$CREDS_DIR/infisical-client-id fehlt (Host-Identität)"
    CLIENT_ID=$(cat "$CREDS_DIR/infisical-client-id")
    if [ -f "$CREDS_DIR/infisical-client-secret.cred" ]; then
      CLIENT_SECRET=$(systemd-creds decrypt --name=infisical-client-secret "$CREDS_DIR/infisical-client-secret.cred" -)
    else
      die "$CREDS_DIR/infisical-client-secret.cred fehlt (mit systemd-creds verschlüsselte Host-Identität)"
    fi
    TOKEN=$(infisical login --method=universal-auth --client-id="$CLIENT_ID" --client-secret="$CLIENT_SECRET" \
              --domain="$INFISICAL_DOMAIN" --silent --plain) || die "Anmeldung bei Infisical fehlgeschlagen"
    unset CLIENT_SECRET
    infisical export --token="$TOKEN" --projectId="$INFISICAL_ID" --env="$ENVIRONMENT" --format=json \
      --domain="$INFISICAL_DOMAIN" --silent > "$TMP/export.json" || die "Secrets aus Infisical konnten nicht geladen werden"
    unset TOKEN
    ;;
  file)
    # Nur für Tests: JSON-Datei mit {"NAME": "wert"}
    SRC="$TEST_SECRETS_DIR/$NAME.json"
    [ -r "$SRC" ] || die "$SRC fehlt"
    jq '[to_entries[] | {key: .key, value: (.value | tostring)}]' "$SRC" > "$TMP/export.json"
    ;;
  *) die "Unbekannter SECRETS_PROVIDER: $SECRETS_PROVIDER" ;;
esac

jq -e 'type == "array"' "$TMP/export.json" >/dev/null || die "Unerwartetes Format der Secrets"
mkdir -p "$DEST"
chmod 0755 "$DEST"
KEYS=()
while IFS= read -r key; do
  valid_secret_key "$key" || { log "Überspringe Secret mit ungültigem Namen"; continue; }
  jq -j --arg k "$key" '[.[] | select((.key // .secretKey) == $k)][0] | (.value // .secretValue // "")' "$TMP/export.json" > "$DEST/.$key.tmp"
  chmod 0444 "$DEST/.$key.tmp"
  mv -f "$DEST/.$key.tmp" "$DEST/$key"
  KEYS+=("$key")
done < <(jq -r '.[] | (.key // .secretKey // empty)' "$TMP/export.json" | sort -u)

# Secrets, die es nicht mehr gibt, entfernen
for f in "$DEST"/*; do
  [ -e "$f" ] || continue
  k=$(basename "$f"); found=0
  for x in "${KEYS[@]}"; do [ "$x" = "$k" ] && found=1 && break; done
  [ $found -eq 1 ] || rm -f "$f"
done
log "${#KEYS[@]} Secrets für $NAME aktualisiert"
