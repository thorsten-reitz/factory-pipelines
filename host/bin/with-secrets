#!/bin/sh
# with-secrets: Entrypoint-Wrapper für App-Container. Exportiert jede Datei in $SECRETS_PATH
# (Standard /run/secrets/app) als Umgebungsvariable (Dateiname = Name, Inhalt = Wert) und startet
# dann den eigentlichen Befehl. So stehen Secrets nie in der Container-Konfiguration auf der Platte.
#   compose.yml:  entrypoint: ["/factory/with-secrets"]
#                 command: ["node", "server.js"]
set -eu
dir="${SECRETS_PATH:-/run/secrets/app}"
if [ -d "$dir" ]; then
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    k=$(basename "$f")
    case "$k" in
      ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;;
    esac
    v=$(cat "$f"; printf x)
    v=${v%x}
    export "$k=$v"
  done
fi
[ "$#" -gt 0 ] || { echo "with-secrets: kein Befehl angegeben" >&2; exit 64; }
exec "$@"
