{
  "$schema": "../../../schema/delivery.schema.json",
  "project": "demo",
  "tier": "k3s",
  "environments": {
    "test": {
      "e2e": true,
      "services": "deploy/compose.test.yml",
      "url": "http://localhost:8080"
    },
    "staging": {
      "url": "http://localhost:8081",
      "autoDeploy": false
    }
  },
  "state": [
    {
      "type": "postgres",
      "service": "db"
    },
    {
      "type": "volume",
      "name": "uploads"
    }
  ],
  "health": {
    "components": [
      "db",
      "storage"
    ]
  }
}
